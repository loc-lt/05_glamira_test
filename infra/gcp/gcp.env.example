# Copy to infra/gcp/gcp.env and fill in. gcp.env is gitignored.
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-b

# Bucket names are global. Keep the project id suffix so the name is free.
GCS_BUCKET=glamira-raw-data-asia-southeast1-your-project-id

# Service account attached to the VM. It reads the bucket without a JSON key.
GCP_SA_NAME=glamira-vm

# VM for MongoDB. e2-standard-4 = 4 vCPU, 16 GB RAM (the coach asks for 16-32 GB).
VM_NAME=glamira-mongo
VM_MACHINE_TYPE=e2-standard-4
VM_DISK_SIZE=100GB
VM_TAG=glamira-mongo
